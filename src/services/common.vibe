  testnet: false,
})

// Layer combinators for composing Common tweaks declaratively

/** Derive a new Common Layer with fork configuration attached to an existing Common. */
export function withFork(forkConfig: ForkConfig) {
  return Layer.effect(
    Common,
    effect {
      const current = try Common
      return try validateChainSpec({ ...current, fork: forkConfig })
    },
  )
}

/** Derive a new Common Layer with updated mining configuration. */
export function withMining(mining: MiningConfig) {
  return Layer.effect(
    Common,
    effect {
      const current = try Common
      return try validateChainSpec({ ...current, mining })
    },
  )
}

/** Derive a new Common Layer with updated hardfork. */
export function withHardfork(hardfork: Hardfork) {
  return Layer.effect(
    Common,
    effect {
      const current = try Common
      return try validateChainSpec({ ...current, hardfork })
    },
  )
}

/** Derive a new Common Layer with updated chainId. */
export function withChainId(chainId: number) {
  return Layer.effect(
    Common,
    effect {
      const current = try Common
      return try validateChainSpec({ ...current, chainId })
    },
  )
}
