export effect function getTransactionReceipt(
  txHash: Hash32,
): (ReceiptObject | null)!TransportError!Transport {
  const transport = try Transport
  return try transport.request<ReceiptObject | null>("eth_getTransactionReceipt", [txHash])
}

export interface WaitForReceiptOptions {
  readonly pollInterval?: Duration.Input
  readonly maxAttempts?: number
}

/**
 * Poll `eth_getTransactionReceipt` using Effect Clock until mined or maxAttempts reached.
 * Deterministic under `TestClock` in tests!
 */
export effect function waitForTransactionReceipt(
  txHash: Hash32,
  options: WaitForReceiptOptions = {},
): ReceiptObject!(TransportError | ReceiptTimeoutError)!Transport {
  const pollInterval = options.pollInterval ?? "100 millis"
  const maxAttempts = options.maxAttempts ?? 120
  for (let attempt = 0; attempt < maxAttempts; attempt++) {
    const receipt = try getTransactionReceipt(txHash)
    if (receipt !== null) return receipt
    if (attempt + 1 < maxAttempts) {
      try sleep(pollInterval)
    }
  }
  throw new ReceiptTimeoutError({
    txHash,
    message: `Transaction receipt not found for ${txHash} after ${maxAttempts} attempts`,
  })
}

export effect function getBlockReceipts(
  block: BlockSelector = "latest",
): (readonly ReceiptObject[] | null)!TransportError!Transport {
  const transport = try Transport
  return try transport.request<readonly ReceiptObject[] | null>("eth_getBlockReceipts", [
    formatBlockSelector(block),
  ])
}

export function formatLogFilter(filter: LogFilter): Record<string, unknown> {
  const out: Record<string, unknown> = {}
  if (filter.blockHash !== undefined) {
    out["blockHash"] = filter.blockHash
  } else {
    if (filter.fromBlock !== undefined) out["fromBlock"] = formatBlockSelector(filter.fromBlock)
    if (filter.toBlock !== undefined) out["toBlock"] = formatBlockSelector(filter.toBlock)
  }
  if (filter.address !== undefined) out["address"] = filter.address
  if (filter.topics !== undefined) out["topics"] = filter.topics
  return out
}

export effect function getLogs(filter: LogFilter): (readonly LogObject[])!TransportError!Transport {
  const transport = try Transport
  return try transport.request<readonly LogObject[]>("eth_getLogs", [formatLogFilter(filter)])
}

