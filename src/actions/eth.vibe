// Standard Ethereum JSON-RPC actions.
// Every action is a composable Effect depending ONLY on `Transport` — completely
// decoupled from how the transport is backed (in-process ZEVM, HTTP, fallback, mock).

import { CodecError, ReceiptTimeoutError, TransportError } from "../errors.vibe"
import {
  formatBlockSelector,
  formatStateOverrideSet,
  formatTransactionRequest,
  parseQuantityHex,
  toQuantityHex,
} from "../hex.vibe"
import { Transport } from "../services/transport.vibe"
import type {
  AccessListResult,
  Address,
  BlockObject,
  BlockSelector,
  Bytes32,
  FeeHistoryResult,
  Hash32,
  Hex,
  LogFilter,
  LogObject,
  QuantityHex,
  ReceiptObject,
  StateOverrideSet,
  TransactionObject,
  TransactionRequest,
  TxPoolContent,
  TxPoolStatus,
} from "../types.vibe"

// Core reads

export effect function getChainId(): bigint!(TransportError | CodecError)!Transport {
  const transport = try Transport
  const hex = try transport.request<QuantityHex>("eth_chainId")
  return try parseQuantityHex(hex)
}

export effect function getBlockNumber(): bigint!(TransportError | CodecError)!Transport {
  const transport = try Transport
  const hex = try transport.request<QuantityHex>("eth_blockNumber")
  return try parseQuantityHex(hex)
}

export effect function getBalance(
  address: Address,
  block?: BlockSelector,
): bigint!(TransportError | CodecError)!Transport {
  const transport = try Transport
  const hex = try transport.request<QuantityHex>("eth_getBalance", [
    address,
    formatBlockSelector(block),
  ])
  return try parseQuantityHex(hex)
}

export effect function getCode(
  address: Address,
  block?: BlockSelector,
): Hex!TransportError!Transport {
  const transport = try Transport
  return try transport.request<Hex>("eth_getCode", [address, formatBlockSelector(block)])
}

export effect function getStorageAt(
  address: Address,
  slot: Bytes32,
  block?: BlockSelector,
): Bytes32!TransportError!Transport {
  const transport = try Transport
  return try transport.request<Bytes32>("eth_getStorageAt", [
    address,
    slot,
    formatBlockSelector(block),
  ])
}

export effect function getStorageValues(
  storageRequest: Readonly<Record<Address, readonly Bytes32[]>>,
  block?: BlockSelector,
): Readonly<Record<Address, readonly Bytes32[]>>!TransportError!Transport {
  const transport = try Transport
  return try transport.request<Readonly<Record<Address, readonly Bytes32[]>>>(
    "eth_getStorageValues",
    [storageRequest, formatBlockSelector(block)],
  )
}

export effect function getTransactionCount(
  address: Address,
