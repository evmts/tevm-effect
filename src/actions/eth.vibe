  const transport = try Transport
  return try transport.request<Hash32>("eth_sendTransaction", [formatTransactionRequest(tx)])
}

export effect function sendRawTransaction(rawTx: Hex): Hash32!TransportError!Transport {
  const transport = try Transport
  return try transport.request<Hash32>("eth_sendRawTransaction", [rawTx])
}

export effect function signMessage(address: Address, data: Hex): Hex!TransportError!Transport {
  const transport = try Transport
  return try transport.request<Hex>("eth_sign", [address, data])
}

export effect function signTransaction(tx: TransactionRequest): Hex!TransportError!Transport {
  const transport = try Transport
  return try transport.request<Hex>("eth_signTransaction", [formatTransactionRequest(tx)])
}

// Queries

export effect function getBlockByNumber<TFull extends boolean = false>(
  block: BlockSelector = "latest",
  fullTransactions?: TFull,
): (BlockObject<TFull> | null)!TransportError!Transport {
  const transport = try Transport
  return try transport.request<BlockObject<TFull> | null>("eth_getBlockByNumber", [
    formatBlockSelector(block),
    fullTransactions ?? false,
  ])
}

export effect function getBlockByHash<TFull extends boolean = false>(
  blockHash: Hash32,
  fullTransactions?: TFull,
): (BlockObject<TFull> | null)!TransportError!Transport {
  const transport = try Transport
  return try transport.request<BlockObject<TFull> | null>("eth_getBlockByHash", [
    blockHash,
    fullTransactions ?? false,
  ])
}

export effect function getBlockTransactionCountByHash(
  blockHash: Hash32,
): (bigint | null)!(TransportError | CodecError)!Transport {
  const transport = try Transport
  const hex = try transport.request<QuantityHex | null>("eth_getBlockTransactionCountByHash", [
    blockHash,
  ])
  return hex === null ? null : try parseQuantityHex(hex)
}

export effect function getBlockTransactionCountByNumber(
  block: BlockSelector = "latest",
