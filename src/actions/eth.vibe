  const transport = try Transport
  const hex = try transport.request<QuantityHex>("eth_getTransactionCount", [
    address,
    formatBlockSelector(block),
  ])
  return try parseQuantityHex(hex)
}

export effect function getAccounts(): (readonly Address[])!TransportError!Transport {
  const transport = try Transport
  return try transport.request<readonly Address[]>("eth_accounts")
}

export effect function getCoinbase(): Address!TransportError!Transport {
  const transport = try Transport
  return try transport.request<Address>("eth_coinbase")
}

export effect function getGasPrice(): bigint!(TransportError | CodecError)!Transport {
  const transport = try Transport
  const hex = try transport.request<QuantityHex>("eth_gasPrice")
  return try parseQuantityHex(hex)
}

export effect function getMaxPriorityFeePerGas(): bigint!(TransportError | CodecError)!Transport {
  const transport = try Transport
  const hex = try transport.request<QuantityHex>("eth_maxPriorityFeePerGas")
  return try parseQuantityHex(hex)
}

export effect function getBlobBaseFee(): bigint!(TransportError | CodecError)!Transport {
  const transport = try Transport
  const hex = try transport.request<QuantityHex>("eth_blobBaseFee")
  return try parseQuantityHex(hex)
}

export effect function getFeeHistory(
  blockCount: number | bigint,
  newestBlock: BlockSelector,
  rewardPercentiles?: readonly number[],
): FeeHistoryResult!TransportError!Transport {
  const transport = try Transport
  const params: unknown[] = [toQuantityHex(blockCount), formatBlockSelector(newestBlock)]
  if (rewardPercentiles !== undefined) {
    params.push(rewardPercentiles)
  }
  return try transport.request<FeeHistoryResult>("eth_feeHistory", params)
}

// Simulation

export effect function ethCall(
  tx: TransactionRequest,
  block?: BlockSelector,
  stateOverrides?: StateOverrideSet,
): Hex!TransportError!Transport {
  const transport = try Transport
  const params: unknown[] = [formatTransactionRequest(tx), formatBlockSelector(block)]
  if (stateOverrides !== undefined) {
    params.push(formatStateOverrideSet(stateOverrides))
  }
  return try transport.request<Hex>("eth_call", params)
}

export effect function estimateGas(
  tx: TransactionRequest,
  block?: BlockSelector,
  stateOverrides?: StateOverrideSet,
): bigint!(TransportError | CodecError)!Transport {
  const transport = try Transport
  const params: unknown[] = [formatTransactionRequest(tx)]
  if (block !== undefined || stateOverrides !== undefined) {
    params.push(formatBlockSelector(block))
  }
  if (stateOverrides !== undefined) {
    params.push(formatStateOverrideSet(stateOverrides))
  }
  const hex = try transport.request<QuantityHex>("eth_estimateGas", params)
  return try parseQuantityHex(hex)
}

export effect function createAccessList(
  tx: TransactionRequest,
  block?: BlockSelector,
): AccessListResult!TransportError!Transport {
  const transport = try Transport
  const params: unknown[] = [formatTransactionRequest(tx)]
  if (block !== undefined) {
    params.push(formatBlockSelector(block))
  }
  return try transport.request<AccessListResult>("eth_createAccessList", params)
}

export effect function simulateV1(
  payload: Readonly<Record<string, unknown>>,
  block?: BlockSelector,
): (readonly unknown[])!TransportError!Transport {
  const transport = try Transport
  const params: unknown[] = [payload]
  if (block !== undefined) {
    params.push(formatBlockSelector(block))
  }
  return try transport.request<readonly unknown[]>("eth_simulateV1", params)
}

