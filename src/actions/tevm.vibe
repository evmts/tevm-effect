// Chain, Fork, Block Env, TxPool & Metadata Controls

export effect function tevmReset(forkConfig?: ForkConfig | null): boolean!TransportError!Transport {
  const transport = try Transport
  if (forkConfig === undefined) {
    return try transport.request<boolean>("zevm_reset")
  }
  if (forkConfig === null) {
    return try transport.request<boolean>("zevm_reset", [null])
  }
  const payload: Record<string, unknown> = { url: forkConfig.url }
  if (forkConfig.blockNumber !== undefined) {
    payload["blockNumber"] = toQuantityHex(forkConfig.blockNumber)
  }
  return try transport.request<boolean>("zevm_reset", [payload])
}

