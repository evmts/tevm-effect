// State Dump / Load & Storage Persistence

export effect function tevmDumpState(): Hex!TransportError!Transport {
  const transport = try Transport
  return try transport.request<Hex>("zevm_dumpState")
}

export effect function tevmLoadState(stateBlob: Hex): boolean!TransportError!Transport {
  const transport = try Transport
  return try transport.request<boolean>("zevm_loadState", [stateBlob])
}

export effect function tevmDumpStateDecoded(): StateDump!(TransportError | CodecError | JsonRpcParseError)!Transport {
  const hex = try tevmDumpState()
  const jsonText = try hexToUtf8(hex)
  return (try parseJson(jsonText)) as StateDump
}

export effect function tevmLoadStateDecoded(dump: StateDump): boolean!(TransportError | CodecError)!Transport {
  const jsonText = try stringifyJson(dump)
  return try tevmLoadState(utf8ToHex(jsonText))
}

/** Dump current ZEVM state and save it into the injected `StateStorage` under `key`. */
export effect function saveStateToStorage(
  key: string,
): Hex!(TransportError | StorageError)!(Transport | StateStorage) {
  const storage = try StateStorage
  const blob = try tevmDumpState()
  try storage.set(key, blob)
  return blob
}

/** Restore ZEVM state from the injected `StateStorage` by `key`. Returns false if key is absent. */
export effect function restoreStateFromStorage(
  key: string,
): boolean!(TransportError | StorageError)!(Transport | StateStorage) {
  const storage = try StateStorage
  const maybeBlob = try storage.get(key)
  if (Option.isNone(maybeBlob)) return false
  return try tevmLoadState(maybeBlob.value)
}

// Snapshots & Scoped Auto-Rollback

export effect function tevmSnapshot(): QuantityHex!TransportError!Transport {
  const transport = try Transport
  return try transport.request<QuantityHex>("zevm_snapshot")
}

export effect function tevmRevert(
  snapshotId: QuantityHex,
): boolean!(TransportError | SnapshotNotFoundError)!Transport {
  const transport = try Transport
  const reverted = try transport.request<boolean>("zevm_revert", [snapshotId])
  if (!reverted) {
    throw new SnapshotNotFoundError({ snapshotId })
  }
  return true
}

/**
 * Effect-native scoped snapshot: takes a ZEVM snapshot before running `body`,
 * and guarantees reverting to that snapshot when the scope exits — even on failure
 * or fiber interruption! Ideal for isolated tests and speculative simulations.
 */
export effect function withSnapshot<A, E, R>(
  body: A!E!R,
): A!(E | TransportError)!(R | Transport) {
  return try scoped(
    effect {
      const snapshotId = try acquireRelease(tevmSnapshot(), (id) =>
        Effect.ignore(
          effect {
            const transport = try Transport
            try transport.request<boolean>("zevm_revert", [id])
          },
        ))
      void snapshotId
      return try body
    },
  )
}

// Impersonation & Scoped Impersonation

export effect function tevmImpersonateAccount(address: Address): boolean!TransportError!Transport {
  const transport = try Transport
  return try transport.request<boolean>("zevm_impersonateAccount", [address])
}

export effect function tevmStopImpersonatingAccount(address: Address): boolean!TransportError!Transport {
  const transport = try Transport
  return try transport.request<boolean>("zevm_stopImpersonatingAccount", [address])
}

export effect function tevmAutoImpersonateAccount(enabled: boolean): boolean!TransportError!Transport {
  const transport = try Transport
  return try transport.request<boolean>("zevm_autoImpersonateAccount", [enabled])
}

/**
 * Effect-native scoped impersonation: impersonates `address` for the duration of `body`
 * and guarantees calling `zevm_stopImpersonatingAccount` on exit, failure, or interruption.
 */
export effect function withImpersonation<A, E, R>(
  address: Address,
  body: A!E!R,
): A!(E | TransportError)!(R | Transport) {
  return try scoped(
    effect {
      try acquireRelease(tevmImpersonateAccount(address), () => Effect.ignore(tevmStopImpersonatingAccount(address)))
      return try body
    },
  )
}

