// TEVM & ZEVM trusted-mode actions.
// Exposes the complete ZEVM `zevm_*` surface as composable Effect programs, plus
// Effect-native superpowers like scoped `withSnapshot` (auto-reverts even on failure
// or interruption), scoped `withImpersonation`, and `StateStorage`-integrated persistence!

import { CodecError, JsonRpcParseError, SnapshotNotFoundError, StorageError, TransportError } from "../errors.vibe"
import {
  formatBlockSelector,
  formatStateOverrideSet,
  formatTransactionRequest,
  hexToUtf8,
  parseJson,
  parseQuantityHex,
  stringifyJson,
  toQuantityHex,
  utf8ToHex,
} from "../hex.vibe"
import { StateStorage } from "../services/storage.vibe"
import { Transport } from "../services/transport.vibe"
import type {
  AccountState,
  AccountStateWire,
  Address,
  BlockSelector,
  Bytes32,
  CallParams,
  CallResult,
  ForkConfig,
  Hash32,
  Hex,
  MineParams,
  MinedBlockSummary,
  NodeInfo,
  NodeMetadata,
  QuantityHex,
  ReceiptObject,
  SetAccountParams,
  StateDump,
} from "../types.vibe"

// Call / Execution

/**
 * Simulate an EVM call (`eth_call`), or submit (`addToMempool`) and optionally
 * mine (`addToBlockchain`) a transaction in trusted mode.
 */
export effect function tevmCall(params: CallParams): CallResult!TransportError!Transport {
  const transport = try Transport
  const tx = formatTransactionRequest(params)

  if (params.addToMempool || params.addToBlockchain) {
    if (tx["from"] === undefined) {
      const accounts = try transport.request<readonly Address[]>("eth_accounts")
      if (accounts.length > 0) {
        tx["from"] = accounts[0]
      }
    }
    const txHash = try transport.request<Hash32>("eth_sendTransaction", [tx])
    if (!params.addToBlockchain) {
      return { rawData: "0x", txHash }
    }
    let receipt = try transport.request<ReceiptObject | null>("eth_getTransactionReceipt", [txHash])
    if (receipt === null) {
      try transport.request<boolean>("zevm_mine")
      receipt = try transport.request<ReceiptObject | null>("eth_getTransactionReceipt", [txHash])
    }
    return { rawData: "0x", txHash, receipt }
  }

  const rpcParams: unknown[] = [tx, formatBlockSelector(params.blockTag)]
  if (params.stateOverride !== undefined) {
    rpcParams.push(formatStateOverrideSet(params.stateOverride))
  }
  const rawData = try transport.request<Hex>("eth_call", rpcParams)
  return { rawData }
}

// Account & State Controls

export effect function tevmGetAccount(
  address: Address,
  block?: BlockSelector,
): AccountState!(TransportError | CodecError)!Transport {
  const transport = try Transport
  const params: unknown[] = block === undefined ? [address] : [address, formatBlockSelector(block)]
  const raw = try transport.request<AccountStateWire>("zevm_getAccount", params)
  return {
    address,
    balance: try parseQuantityHex(raw.balance),
    nonce: try parseQuantityHex(raw.nonce),
    code: raw.code,
    storage: raw.storage,
  }
}

/**
 * Update specified account fields in trusted state.
 * Preserves unspecified fields by performing individual ZEVM mutations.
 */
export effect function tevmSetAccount(params: SetAccountParams): void!TransportError!Transport {
  const transport = try Transport
  if (params.balance !== undefined) {
    try transport.request<boolean>("zevm_setBalance", [params.address, toQuantityHex(params.balance)])
  }
  if (params.nonce !== undefined) {
    try transport.request<boolean>("zevm_setNonce", [params.address, toQuantityHex(params.nonce)])
  }
  if (params.code !== undefined) {
    try transport.request<boolean>("zevm_setCode", [params.address, params.code])
  }
  if (params.storage !== undefined) {
    for (const [slot, value] of Object.entries(params.storage)) {
      try transport.request<boolean>("zevm_setStorageAt", [params.address, slot, value])
    }
  }
}

export effect function tevmSetBalance(
  address: Address,
  balance: bigint | QuantityHex,
): boolean!TransportError!Transport {
  const transport = try Transport
  return try transport.request<boolean>("zevm_setBalance", [address, toQuantityHex(balance)])
}

