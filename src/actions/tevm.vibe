// Mining Controls

export effect function tevmMine(params: MineParams = {}): boolean!TransportError!Transport {
  const transport = try Transport
  const rpcParams: unknown[] = []
  if (params.blocks !== undefined || params.intervalSeconds !== undefined) {
    rpcParams.push(toQuantityHex(params.blocks ?? 1))
  }
  if (params.intervalSeconds !== undefined) {
    rpcParams.push(toQuantityHex(params.intervalSeconds))
  }
  return try transport.request<boolean>("zevm_mine", rpcParams)
}

export effect function tevmMineDetailed(
  params: MineParams = {},
): (readonly MinedBlockSummary[])!TransportError!Transport {
  const transport = try Transport
  const rpcParams: unknown[] = []
  if (params.blocks !== undefined || params.intervalSeconds !== undefined) {
    rpcParams.push(toQuantityHex(params.blocks ?? 1))
  }
  if (params.intervalSeconds !== undefined) {
    rpcParams.push(toQuantityHex(params.intervalSeconds))
  }
  return try transport.request<readonly MinedBlockSummary[]>("zevm_mineDetailed", rpcParams)
}

export effect function tevmGetAutomine(): boolean!TransportError!Transport {
