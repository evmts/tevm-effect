{
  "name": "@tevm/effect",
  "version": "0.1.0",
  "description": "Effect-native, aggressively dependency-injected TEVM powered by ZEVM and Voltaire",
  "license": "MIT",
  "author": "evmts",
  "homepage": "https://github.com/evmts/tevm-effect",
  "repository": {
    "type": "git",
    "url": "https://github.com/evmts/tevm-effect.git"
  },
  "bugs": {
    "url": "https://github.com/evmts/tevm-effect/issues"
  },
  "keywords": [
    "ethereum",
    "evm",
    "tevm",
    "zevm",
    "voltaire",
    "effect",
    "effect-ts",
    "vibelang",
    "json-rpc"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./platform/node": {
      "types": "./dist/platform/node.d.ts",
      "import": "./dist/platform/node.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./voltaire": {
      "types": "./dist/voltaire/index.d.ts",
      "import": "./dist/voltaire/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vibelang",
    "typecheck": "vibelang --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "vibelang format --write",
    "format:check": "vibelang format --check",
    "lint": "vibelang lint -p tsconfig.test.json",
    "check": "vibelang format --check && vibelang lint -p tsconfig.test.json && vitest run"
  },
  "dependencies": {
    "effect": "4.1.1",
    "vibelang-runtime": "0.0.13"
  },
  "peerDependencies": {
    "@effect/platform-node": "4.1.1",
    "@evmts/zevm": ">=0.0.0"
  },
  "peerDependenciesMeta": {
    "@effect/platform-node": {
      "optional": true
    },
    "@evmts/zevm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@effect/platform-node": "4.1.1",
    "@effect/vitest": "4.1.1",
    "@types/node": "^22.15.0",
    "vibelang": "0.0.13",
    "vibelang-vite": "0.0.13",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "^22.22.3 || >=24.11.1"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.1.1"
  },
  "resolutions": {
    "@effect/platform-node-shared": "4.1.1"
  }
}
